# CiftPay local configuration. Copy to .env and adjust.
# Never commit a real secret: this file is the documentation, .env is ignored.

# ---------------------------------------------------------------- application
# local | staging | production. Controls log format and dev-only shortcuts
# (in local the OTP code is logged instead of being sent by SMS).
APP_ENV=local
# Address the api binary listens on.
HTTP_ADDR=:8080
# Absolute base URL of the web app as seen from a buyer's phone. Used to build
# the public receipt links (PUBLIC_BASE_URL + /r/<code>) that go out by SMS;
# the web app renders that page, the api only serves its JSON.
PUBLIC_BASE_URL=http://localhost:3000
# Absolute base URL of the api as reachable by Safaricom. It is the base of the
# webhook URLs handed to Daraja (RegisterURL, STK callbacks). For a sandbox run
# on a laptop point it at a tunnel, e.g. https://<name>.trycloudflare.com .
WEBHOOK_BASE_URL=http://localhost:8080
# Comma separated list of origins allowed to call the api with credentials.
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------- database
# When running the stack with docker compose the api and worker containers get
# postgres://ciftpay:ciftpay@postgres:5432/... . This value is for tools you run
# on the host (ciftctl migrate, ciftctl seed, make replay-webhook).
DATABASE_URL=postgres://ciftpay:ciftpay@localhost:5432/ciftpay?sslmode=disable
DATABASE_MAX_CONNS=10
# Host port docker compose publishes the postgres container on. Change it (and
# the port in DATABASE_URL above) when another Postgres already owns 5432.
PG_PORT=5432

# --------------------------------------------------------------------- crypto
# HMAC key for session cookies. 32+ random bytes: openssl rand -base64 32
SESSION_SECRET=dev-session-secret-change-me
# Envelope encryption master key: exactly 32 bytes, base64 encoded.
# openssl rand -base64 32
# Rotating this makes every msisdn_enc / kra_pin_enc column unreadable.
MASTER_KEY_B64=ZGV2LW1hc3Rlci1rZXktMzItYnl0ZXMtZm9yLWRldiE=
# Pepper for the lookup hashes (msisdn_hash, pin_hash). Must be stable forever.
HASH_PEPPER=dev-hash-pepper-change-me

# -------------------------------------------------------------------- uploads
# Where the signed Safaricom authorization letters (ADR-0008) are stored. Local
# disk; never served publicly (only GET /admin/shortcodes/{id}/authorization).
# docker compose mounts the `uploads` volume at /var/lib/ciftpay/uploads.
UPLOAD_DIR=./var/uploads

# ------------------------------------------------------- Safaricom Daraja API
# sandbox | production
DARAJA_ENV=sandbox
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
# CiftPay's own C2B shortcode. 600000 is the Daraja sandbox test Till that is
# pre-mapped to every sandbox app; it is what `make register-urls` /
# `make simulate-c2b` target. There is no DARAJA_PASSKEY: CiftPay initiates no
# M-Pesa transactions in Phase 1 (ADR-0003, ADR-0008).
DARAJA_SHORTCODE=600000
# Random path segment appended to the webhook URLs registered with Safaricom,
# e.g. /webhooks/daraja/c2b/confirmation/<token>. Acts as a shared secret on top
# of the IP allow-list. openssl rand -hex 24
DARAJA_WEBHOOK_TOKEN=dev-webhook-token
# Comma separated CIDRs allowed to post webhooks. Empty disables the check
# (local development only).
DARAJA_IP_ALLOWLIST=

# ------------------------------------------------------------- KRA eTIMS port
# mock   - deterministic acks, no network (development and tests)
# oscu   - direct KRA eTIMS OSCU integration with CiftPay's own developer
#          credentials (MVP path since 2026-09-14, see ADR-0009)
# vendor - KRA-approved third-party integrator (kept as a fallback, ADR-0002)
FISCAL_ADAPTER=mock
FISCAL_VENDOR_BASE_URL=
FISCAL_VENDOR_API_KEY=
# Seconds before a submission attempt is abandoned and retried.
FISCAL_TIMEOUT_SECONDS=20
# mock adapter only: none | retryable | terminal. Forces failures so the retry
# and NEEDS_REVIEW paths can be exercised locally.
MOCK_FAIL_MODE=none

# ------------------------------------------------- KRA eTIMS OSCU (direct)
# CiftPay's own OSCU developer app on the KRA API gateway (ADR-0009). Used by
# FISCAL_ADAPTER=oscu; ignored otherwise.
# sandbox | production
KRA_OSCU_ENV=sandbox
# Gateway origin. Tokens come from GET {BASE}/v1/token/generate?grant_type=
# client_credentials with HTTP Basic Base64(key:secret) - a GET, not a POST.
KRA_OSCU_BASE_URL=https://sbx.kra.go.ke
KRA_OSCU_CONSUMER_KEY=
KRA_OSCU_CONSUMER_SECRET=
# dvcSrlNo registered for the CiftPay OSCU on the eTIMS portal. Device
# initialisation (selectInitOsdcInfo) exchanges it for the cmcKey.
KRA_OSCU_DEVICE_SERIAL=
KRA_OSCU_TEST_PIN=
KRA_OSCU_TEST_BHF_ID=00
KRA_OSCU_TEST_DEVICE_SERIAL=
# sbx.kra.go.ke is DNSSEC-misconfigured; validating local resolvers
# (systemd-resolved) answer SERVFAIL. The client resolves through this UDP
# address instead. Empty = system resolver.
KRA_OSCU_DNS_RESOLVER=8.8.8.8:53

# ----------------------------------------------------- Africa's Talking (SMS)
# Locally this points at the sms-sink container, which stores messages in
# memory and shows them on http://localhost:8025 .
AT_BASE_URL=http://localhost:8025
AT_USERNAME=sandbox
AT_API_KEY=dev-at-key
AT_SENDER_ID=CIFTPAY

# ------------------------------------------------------------------------ web
# Base URL the browser uses to reach the api.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Base URL the Next.js server uses to reach the api (container to container).
API_BASE_URL=http://localhost:8080
