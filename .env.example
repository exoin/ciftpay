# CiftPay local configuration. Copy to .env and adjust.
# Never commit a real secret: this file is the documentation, .env is ignored.

# ---------------------------------------------------------------- application
# local | staging | production. Controls log format and dev-only shortcuts
# (in local the OTP code is logged instead of being sent by SMS).
APP_ENV=local
# Address the api binary listens on.
HTTP_ADDR=:8080
# Absolute base URL of the api as seen from the outside world. Used to build
# the public receipt links (PUBLIC_BASE_URL + /r/<code>) that go out by SMS.
PUBLIC_BASE_URL=http://localhost:8080
# Comma separated list of origins allowed to call the api with credentials.
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------- database
# When running the stack with docker compose the api and worker containers get
# postgres://ciftpay:ciftpay@postgres:5432/... . This value is for tools you run
# on the host (ciftctl migrate, ciftctl seed, make replay-webhook).
DATABASE_URL=postgres://ciftpay:ciftpay@localhost:5432/ciftpay?sslmode=disable
DATABASE_MAX_CONNS=10

# --------------------------------------------------------------------- crypto
# HMAC key for session cookies. 32+ random bytes: openssl rand -base64 32
SESSION_SECRET=dev-session-secret-change-me
# Envelope encryption master key: exactly 32 bytes, base64 encoded.
# openssl rand -base64 32
# Rotating this makes every msisdn_enc / kra_pin_enc column unreadable.
MASTER_KEY_B64=ZGV2LW1hc3Rlci1rZXktMzItYnl0ZXMtZm9yLWRldiE=
# Pepper for the lookup hashes (msisdn_hash, pin_hash). Must be stable forever.
HASH_PEPPER=dev-hash-pepper-change-me

# ------------------------------------------------------- Safaricom Daraja API
# sandbox | production
DARAJA_ENV=sandbox
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
# The shortcode CiftPay itself uses for STK verification pings and billing.
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
# Random path segment appended to the webhook URLs registered with Safaricom,
# e.g. /webhooks/mpesa/c2b/confirmation/<token>. Acts as a shared secret on top
# of the IP allow-list. openssl rand -hex 24
DARAJA_WEBHOOK_TOKEN=dev-webhook-token
# Comma separated CIDRs allowed to post webhooks. Empty disables the check
# (local development only).
DARAJA_IP_ALLOWLIST=

# ------------------------------------------------------------- KRA eTIMS port
# mock   - deterministic acks, no network (development and tests)
# vendor - KRA-approved third-party integrator (MVP, see ADR-0002)
# oscu   - direct KRA OSCU integration (Phase 3)
FISCAL_ADAPTER=mock
FISCAL_VENDOR_BASE_URL=
FISCAL_VENDOR_API_KEY=
# Seconds before a submission attempt is abandoned and retried.
FISCAL_TIMEOUT_SECONDS=20
# mock adapter only: none | retryable | terminal. Forces failures so the retry
# and NEEDS_REVIEW paths can be exercised locally.
MOCK_FAIL_MODE=none

# ----------------------------------------------------- Africa's Talking (SMS)
# Locally this points at the sms-sink container, which stores messages in
# memory and shows them on http://localhost:8025 .
AT_BASE_URL=http://localhost:8025
AT_USERNAME=sandbox
AT_API_KEY=dev-at-key
AT_SENDER_ID=CIFTPAY

# ------------------------------------------------------------------------ web
# Base URL the browser uses to reach the api.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Base URL the Next.js server uses to reach the api (container to container).
API_BASE_URL=http://localhost:8080
