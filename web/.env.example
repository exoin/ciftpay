# Where the browser reaches the API (published compose port or the public host).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Where the Next.js server reaches the API (compose service name in docker).
API_BASE_URL=http://localhost:8080
# Public origin of this web app, used for absolute receipt links in metadata.
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
