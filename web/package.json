{
  "name": "ciftpay-web",
  "version": "0.1.0",
  "private": true,
  "description": "CiftPay merchant / accountant / admin PWA and public receipt page",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
